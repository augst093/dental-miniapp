# ==============================================================================
# DENTALUX TASHKENT - TELEGRAM MINI APP (NEXT.JS) CONFIGURATION
# ==============================================================================

# Database Connection (Optional in local/demo mode; required for persistent PostgreSQL on Railway/Supabase)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/dentalux?schema=public"

# Telegram Bot Token (from @BotFather) - used for server-side HMAC validation of initData
BOT_TOKEN=your_telegram_bot_token_here

# Administrator Telegram User IDs (comma-separated if multiple)
# Users with these IDs get access to the Admin Panel in the Mini App
ADMIN_ID=123456789,987654321

# Demo Mode: 'true' enables the floating Demo Control Drawer and mock admin role switching
DEMO_MODE=true

# Next.js Public Configuration
NEXT_PUBLIC_APP_URL=https://dentalminiapp.vercel.app
